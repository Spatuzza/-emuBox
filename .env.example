# ==============================================================================
# Ñemubox - Variables de entorno (copiar a .env antes de levantar Docker)
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_DB=emubox
POSTGRES_USER=emubox
POSTGRES_PASSWORD=emubox_dev_change_me
POSTGRES_PORT=5432

# --- API (Node.js + Fastify + Prisma) ---
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://emubox:emubox_dev_change_me@postgres:5432/emubox?schema=public

# --- Web (React + Vite) ---
WEB_PORT=5173
VITE_API_PROXY_TARGET=http://api:3000

# --- SIFEN / e-Kuatia (Paraguay) ---
# Modos permitidos:
#   mock -> Demo local inmediata (XML v150 + CDC real + KuDE PDF, sin certificado .p12)
#   test -> Ambiente de pruebas DNIT (sifen-test.set.gov.py, requiere .p12 y alta Marangatu)
#   prod -> Producción DNIT (sifen.set.gov.py)
SIFEN_MODE=mock
SIFEN_CSC_ID=0001
SIFEN_CSC=ABCD0000000000000000000000000000
SIFEN_CERT_PATH=/app/certs/certificado.p12
SIFEN_CERT_PASSWORD=

# --- Datos base del Emisor (para seed inicial en modo demo) ---
EMITTER_RUC=80012345
EMITTER_DV=6
EMITTER_RAZON_SOCIAL=Comercio Demo Ñemubox S.R.L.
EMITTER_TIMBRADO=12558946
EMITTER_ESTABLECIMIENTO=001
EMITTER_PUNTO_EXPEDICION=001
